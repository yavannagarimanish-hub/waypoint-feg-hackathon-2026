# WAYPOINT - Environment Configuration Template
# ==============================================================================
# NOTE: Waypoint is designed to run 100% self-contained as a client-side prototype.
# No .env file or external API keys are required for local development or demo.
# ==============================================================================

# Application Port (default: 5173 for Vite dev server)
PORT=5173

# Application Title
VITE_APP_TITLE=WAYPOINT - Intelligent Sportsbook

# Demo & Simulation Mode (true = enabled)
VITE_DEMO_MODE=true

# Chaos Simulation Enabled (true = enabled)
VITE_CHAOS_SIMULATION_ENABLED=true

